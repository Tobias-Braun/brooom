# Rendered by the nginx entrypoint (envsubst) into /tmp/site-url.conf at
# container start, so the public origin is a runtime setting of the image (see
# Dockerfile). Trailing slashes are stripped so "https://example.com/" and
# "https://example.com" yield the same URLs.
map "${SITE_URL}" $site_origin {
    "~^(?<origin>.*?)/*$" $origin;
}

# The Umami tracker is opt-in at container start as well: only when both
# UMAMI_SCRIPT_URL and UMAMI_WEBSITE_ID are set does the <!--umami--> marker in
# every page become the script tag (see nginx.conf); otherwise it is removed.
map "${UMAMI_SCRIPT_URL}|${UMAMI_WEBSITE_ID}" $umami_tag {
    "~^(?<src>[^|]+)\|(?<id>.+)$" '<script defer src="$src" data-website-id="$id"></script>';
    default "";
}
