---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import PresetsSlot from '../components/PresetsSlot.astro';
import TerminalSlot from '../components/TerminalSlot.astro';
import InstallSlot from '../components/InstallSlot.astro';
import FeatureGrid from '../components/FeatureGrid.astro';
import Detectors from '../components/Detectors.astro';
import ConfigExample from '../components/ConfigExample.astro';
import GithubCta from '../components/GithubCta.astro';
import Footer from '../components/Footer.astro';
---

<Base>
  <Header />
  <main id="main">
    <Hero />
    <PresetsSlot />
    <TerminalSlot />
    <InstallSlot />
    <FeatureGrid />
    <Detectors />
    <ConfigExample />
    <GithubCta />
  </main>
  <Footer />
</Base>
