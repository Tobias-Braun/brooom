---
import Base from './Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<Base title={`${title} - Brooom`} description={`${title} of the Brooom website.`}>
  <Header />
  <main id="main" class="wrap legal">
    <h1>{title}</h1>
    <slot />
  </main>
  <Footer />
</Base>

<style>
  .legal {
    max-width: calc(48rem + 2 * var(--gutter));
    padding-block: var(--space-5) var(--space-6);
  }

  h1 {
    font-size: clamp(2rem, 1.4rem + 3vw, 3rem);
  }

  /* The prose is slotted in by the pages, so the scoped styles need :global. */
  .legal :global(h2) {
    margin-top: var(--space-5);
    font-size: 1.35rem;
  }

  .legal :global(p),
  .legal :global(li) {
    color: var(--text-muted);
  }

  .legal :global(ul) {
    margin: 0 0 var(--space-3);
    padding-left: var(--space-4);
  }
</style>
