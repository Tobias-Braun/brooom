---
import { REPO_URL } from '../lib/url';
---

<section class="section" aria-labelledby="github-title">
  <div class="wrap">
    <div class="card cta">
      <h2 id="github-title">Open source on GitHub</h2>
      <p>
        Read the code, follow the progress towards v0.1.0, file an issue or add a tool to the
        agent-artifact catalog.
      </p>
      <a class="btn btn-primary" href={REPO_URL}>Tobias-Braun/brooom</a>
    </div>
  </div>
</section>

<style>
  .cta {
    text-align: center;
    padding: var(--space-5) var(--gutter);
    background: linear-gradient(135deg, rgb(139 92 246 / 0.16), rgb(96 165 250 / 0.1)), var(--surface);
  }

  .cta p {
    max-width: 34rem;
    margin-inline: auto;
    margin-bottom: var(--space-4);
    color: var(--text-muted);
  }
</style>
