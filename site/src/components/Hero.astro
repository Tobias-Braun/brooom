---
import HeroScene from './HeroScene.astro';
import DevNote from './DevNote.astro';
---

<section class="hero" aria-labelledby="hero-title">
  <div class="wrap">
    <div class="copy">
      <DevNote />
      <span class="eyebrow">CLI for AI-assisted development</span>
      <h1 id="hero-title">
        <span class="gradient-text">Sweep your workspace clean</span>, fast, so your agent fleet can run again.
      </h1>
      <p class="sub">
        Brooom finds and cleans the disk clutter that agent tools, parallel branches and forgotten
        projects leave behind. Nothing changes before you have seen the plan and said yes.
      </p>
      <div class="ctas">
        <a class="btn btn-primary" href="#install">Install</a>      </div>
    </div>
    <HeroScene />
  </div>
</section>

<style>
  .hero {
    padding-block: var(--space-6) var(--space-5);
  }

  .sub {
    max-width: 38rem;
    color: var(--text-muted);
    font-size: clamp(1.05rem, 1rem + 0.5vw, 1.3rem);
  }

  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-4);
  }
</style>
