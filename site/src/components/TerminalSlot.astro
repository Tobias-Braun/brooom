---
import TerminalDemo from './TerminalDemo.vue';

/**
 * Slot of the animated terminal island (#43). The island is server-rendered
 * with the completed final frame, which is also the no-JavaScript view; the
 * section, heading and caption stay static. Output is illustrative and lives
 * in src/lib/terminal-script.ts.
 */
---

<section class="section demo" aria-labelledby="demo-title">
  <div class="wrap">
    <h2 id="demo-title">See what a sweep would do</h2>
    <p class="section-intro">
      <code>br sweep</code> is the no-brainer command: a safe preset, grouped by detector, with
      the reclaimable space up front.
    </p>
    <TerminalDemo client:visible />
    <p class="caption">Illustrative output</p>
    <p class="caption">
      <code>br</code> is the short name the install script adds next to <code>brooom</code>. If
      something on your machine already uses <code>br</code>, the installer tells you, and
      <code>brooom</code> works just the same.
    </p>
  </div>
</section>

<style>
  .caption {
    margin: var(--space-2) 0 0;
    color: var(--text-muted);
    font-size: 0.9rem;
  }
</style>
