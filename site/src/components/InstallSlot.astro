---
import InstallTabs from './InstallTabs.vue';
import { REPO_URL } from '../lib/url';

/**
 * Slot of the tabbed install island (#43). The island renders its first tab
 * on the server. Without JavaScript the other tabs cannot be reached, so the
 * noscript block repeats the honest static fallback: no release yet, and
 * building from source is what works today.
 */
---

<section class="section install" aria-labelledby="install-title">
  <div class="wrap">
    <h2 id="install-title">Install</h2>
    <InstallTabs client:idle />
    <noscript>
      <div class="card fallback">
        <p>
          Brooom is under active development towards the first major release and has no
          release yet. With Go installed you can build it from source today:
        </p>
        <div class="code-block">
          <pre tabindex="0"><code>go install github.com/Tobias-Braun/brooom/cmd/brooom@latest</code></pre>
        </div>
        <p class="links">
          <a href={REPO_URL}>Source on GitHub</a>
          <a href={`${REPO_URL}/releases`}>Releases</a>
        </p>
      </div>
    </noscript>
  </div>
</section>

<style>
  .fallback {
    margin-top: var(--space-3);
  }

  .fallback .code-block {
    margin-bottom: var(--space-3);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    margin: 0;
  }

  .links a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }
</style>
