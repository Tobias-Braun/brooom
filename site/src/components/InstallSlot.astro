---
import InstallTabs from './InstallTabs.vue';
import { installTabs } from '../lib/install-tabs';
import { REPO_URL } from '../lib/url';
import DevNote from './DevNote.astro';

/**
 * Slot of the tabbed install island (#43). The island renders its first tab
 * on the server. Without JavaScript the other tabs cannot be reached, so the
 * noscript block repeats the commands of every available tab.
 */
---

<section class="section install" aria-labelledby="install-title">
  <div class="wrap">
    <DevNote />
    <h2 id="install-title">Install</h2>
    <InstallTabs client:idle />
    <noscript>
      <div class="card fallback">
        {
          installTabs
            .filter((t) => t.status === 'available')
            .flatMap((t) => t.blocks)
            .map((block) =>
              block.type === 'text' ? (
                <p>{block.text}</p>
              ) : (
                <div class="code-block">
                  <pre tabindex="0"><code>{block.command}</code></pre>
                </div>
              ),
            )
        }
        <p class="links">
          <a href={REPO_URL}>Source on GitHub</a>
        </p>
      </div>
    </noscript>
  </div>
</section>

<style>
  .fallback {
    margin-top: var(--space-3);
  }

  .fallback .code-block {
    margin-bottom: var(--space-3);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    margin: 0;
  }

  .links a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }
</style>
