---
import { REPO_URL } from '../lib/url';

/**
 * Reserved slot for the tabbed install island (#43). Until releases exist the
 * static content is honest about the status and only offers what works
 * today: building from source. No package manager commands are shown.
 */
---

<section class="section install" aria-labelledby="install-title">
  <div class="wrap">
    <h2 id="install-title">Install</h2>
    <div id="install" data-slot="install" class="card">
      <p>
        Brooom is under active development towards v0.1.0 and has no release yet. Package manager
        support is prepared but not enabled.
      </p>
      <p>With Go installed you can build it from source today:</p>
      <div class="code-block">
        <pre tabindex="0"><code>go install github.com/Tobias-Braun/brooom/cmd/brooom@latest</code></pre>
      </div>
      <p class="links">
        <a href={REPO_URL}>Source on GitHub</a>
        <a href={`${REPO_URL}/releases`}>Releases</a>
      </p>
    </div>
  </div>
</section>

<style>
  .code-block {
    margin-bottom: var(--space-3);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    margin: 0;
  }

  .links a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }
</style>
